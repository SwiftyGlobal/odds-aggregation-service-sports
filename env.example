# Sport Adapter - determines which tables, providers, and sport hooks to use
# Valid values: horse-racing, golf
SPORT_ADAPTER=horse-racing

# Environment
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=feed_sports_db
DB_USER=postgres
DB_PASSWORD=password
PG_SSL=false
PG_POOL_MIN=0
PG_POOL_MAX=20

# Logging Configuration
LOG_LEVEL=2
LOG_FORMAT=text
LOG_CONSOLE=true

# Health Check Configuration
HEALTH_CHECK_PORT=3002

# Aggregation Configuration
AGGREGATION_SYNC_INTERVAL=5
AGGREGATION_BATCH_SIZE=100
AGGREGATION_CONCURRENCY=10
AGGREGATION_MODE=event-driven

# Health Check – which providers to include in /health (recent-data check only)
HEALTH_CHECK_UNIBET_ENABLED=true
HEALTH_CHECK_CORAL_ENABLED=true
HEALTH_CHECK_888SPORT_ENABLED=true
HEALTH_CHECK_NETBET_ENABLED=true

# Performance Configuration
EVENT_MATCHING_THRESHOLD=0.8
PARTICIPANT_MATCHING_THRESHOLD=0.85
ODDS_MAX_AGE_HOURS=24
MIN_PROVIDERS_FOR_AGGREGATION=1

# Concurrency
DB_CONCURRENCY=12

# Polling Configuration
POLL_INTERVAL_MS=1000
POLL_BATCH_LIMIT=500
POLL_CONCURRENCY=40
POLL_RETRY_MAX=3
POLL_RETRY_BASE_MS=100
POLL_CATCHUP_MINUTES=0

# Outbox Configuration
PRE_EVENT_FULL_INTERVAL_MINUTES=10

# Odds Margin Configuration
# Margin percentage to apply to display odds (e.g., 0.05 = 5%)
ODDS_MARGIN_PCT=0.05
# Tolerance for outlier detection based on median deviation (e.g., 0.15 = 15%)
ODDS_OUTLIER_TOLERANCE_PCT=0.15
